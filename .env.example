# Firebase Configuration (Already configured in src/lib/firebase.ts)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wheelers-1179d

# Cloudflare R2 Credentials (Zero Egress Image Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wheelers-media
R2_PUBLIC_URL=https://media.18-wheelers.com

# Adsterra / Monetization Keys
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR=
NEXT_PUBLIC_ADSTERRA_POPUNDER=
NEXT_PUBLIC_ADSTERRA_SMARTLINK=https://www.highrevenuegate.com/example-smartlink
